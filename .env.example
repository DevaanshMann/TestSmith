# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
ANTHROPIC_MODEL=claude-sonnet-5-5
TESTSMITH_EFFORT=medium
TESTSMITH_MAX_ITERATIONS=5
TESTSMITH_HARD_MAX_ITERATIONS=10
TESTSMITH_COVERAGE_TARGET=90
TESTSMITH_SANDBOX_TIMEOUT=20
TESTSMITH_SANDBOX_MEMORY_MB=256
TESTSMITH_LLM_TIMEOUT=90
TESTSMITH_LLM_MAX_RETRIES=4
TESTSMITH_MAX_UPLOAD_BYTES=51200
TESTSMITH_SESSION_TOKEN_BUDGET=250000
TESTSMITH_DAILY_TOKEN_BUDGET=3000000
TESTSMITH_RUNS_PER_SESSION_HOUR=6
TESTSMITH_RUNS_PER_HOUR=60
TESTSMITH_MAX_CONCURRENT_RUNS=2
TESTSMITH_REFUSAL_FALLBACK=true
TESTSMITH_AUDIT_LOG=logs/audit.jsonl
